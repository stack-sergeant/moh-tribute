---
import "@fontsource/oswald/500.css";
import "@fontsource/oswald/600.css";
import "@fontsource/source-sans-3/400.css";
import "@fontsource/source-sans-3/600.css";
import "@fontsource/source-serif-4/400.css";
import "@fontsource/source-serif-4/600.css";
import { ClientRouter } from "astro:transitions";
import CadencePlayer from "../components/CadencePlayer.astro";
import NewsletterSignup from "../components/NewsletterSignup.astro";
import SponsorBar from "../components/SponsorBar.astro";
import "../styles/global.css";
import {
  DEFAULT_SOCIAL_ALT,
  DEFAULT_SOCIAL_HEIGHT,
  DEFAULT_SOCIAL_WIDTH,
  resolveSocialImage,
  usesDefaultSocialImage,
} from "../lib/social-image.mjs";
import { pageUrl } from "../lib/urls";
import { disclaimer, site } from "../site";

interface Props {
  title: string;
  description?: string;
  overlay?: boolean;
  /** Site-root or absolute self-hosted image. Wikimedia hotlinks are not used. */
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  /** Directory pages add the labeled sponsor bar in the footer. */
  sponsorBar?: boolean;
  /** Error document. Search engines should not index it. */
  noindex?: boolean;
}
const {
  title,
  description = site.description,
  overlay = false,
  image,
  imageAlt,
  imageWidth,
  imageHeight,
  sponsorBar = false,
  noindex = false,
} = Astro.props;
const fullTitle = title === site.name ? title : `${title} · ${site.name}`;
const canonical = pageUrl(Astro.url.pathname);
const socialImage = resolveSocialImage(image, site.origin);
const defaultCard = usesDefaultSocialImage(image, site.origin);
const socialAlt = defaultCard ? DEFAULT_SOCIAL_ALT : imageAlt || title;
const socialWidth = defaultCard ? DEFAULT_SOCIAL_WIDTH : imageWidth;
const socialHeight = defaultCard ? DEFAULT_SOCIAL_HEIGHT : imageHeight;
const navPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const navLinks = [
  { href: "/recipients", label: "Recipients" },
  { href: "/battles", label: "Battles" },
  { href: "/on-this-day", label: "On this day" },
  { href: "/audio", label: "Cadences" },
  { href: "/directory", label: "Directory" },
  { href: "/about", label: "About" },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : null}
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={socialImage} />
    {socialWidth ? <meta property="og:image:width" content={socialWidth} /> : null}
    {socialHeight ? <meta property="og:image:height" content={socialHeight} /> : null}
    <meta property="og:image:alt" content={socialAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <ClientRouter />
    <Fragment set:html={'<!-- Cloudflare Web Analytics --><script type=\'module\' src=\'https://static.cloudflareinsights.com/beacon.min.js\' data-cf-beacon=\'{"token": "6674b1a24adb4708a64c73a6d81bf0e0"}\'></script><!-- End Cloudflare Web Analytics -->'} />
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <header class:list={["site-header", { overlay }]}>
      <div class="header-inner">
        <div class="brand">
          <a class="wordmark" href="/">{site.name}</a>
          <p class="tagline">
            <span class="tagline-full">{site.tagline}</span>
            <span class="tagline-short">Unofficial archive</span>
          </p>
        </div>
        <div class="nav-control">
          <input
            type="checkbox"
            id="site-nav-toggle"
            class="nav-check"
            aria-controls="site-nav"
          />
          <label class="nav-toggle" for="site-nav-toggle">
            <span class="nav-toggle-bars" aria-hidden="true"><span></span><span></span><span></span></span>
            <span class="nav-toggle-text">
              <span class="nav-label-open">Menu</span>
              <span class="nav-label-close">Close</span>
            </span>
          </label>
        </div>
        <nav class="nav" id="site-nav" aria-label="Primary">
          {navLinks.map((link) => (
            <a
              href={link.href}
              aria-current={navPath === link.href || navPath.startsWith(`${link.href}/`) ? "page" : undefined}
            >
              {link.label}
            </a>
          ))}
        </nav>
      </div>
    </header>
    <main id="content">
      <slot />
    </main>
    <footer class="site-footer">
      {sponsorBar && <SponsorBar />}
      <NewsletterSignup />
      <div class="footer-inner">
        <slot name="credits" />
        <p>{disclaimer}</p>
        <p>
          Official citations are U.S. government works. Photographs are shown only
          when a public-domain or Creative Commons file could be matched, with the
          license and credit on the page.
          <a href="/about">Sources and photo rules</a>.
          <a href="/valor-awards">U.S. military valor awards, ranked</a>.
          Optional cadence audio is a separate public-domain recording and stays off until you press play.
          <a href="/audio">Cadence credits</a>.
          <a href="/directory">Veteran-owned businesses and military museums</a>.
        </p>
      </div>
    </footer>
    <CadencePlayer />
    <script>
      const mark = window;
      if (!mark.__navBound) {
        mark.__navBound = true;
        const mobileNav = window.matchMedia("(max-width: 767px)");

        function inputEl(header = document.querySelector(".site-header")) {
          const input = header?.querySelector(".nav-check");
          return input instanceof HTMLInputElement ? input : null;
        }

        function sync(input) {
          if (!input) return;
          const show = input.checked && mobileNav.matches;
          if (input.checked !== show) input.checked = show;
          input.setAttribute("role", "button");
          input.setAttribute("aria-expanded", show ? "true" : "false");
          input.setAttribute("aria-controls", "site-nav");
          input.closest(".site-header")?.classList.toggle("menu-open", show);
        }

        document.addEventListener("change", (event) => {
          const input = event.target;
          if (input instanceof HTMLInputElement && input.classList.contains("nav-check")) sync(input);
        });

        document.addEventListener("click", (event) => {
          if (!(event.target instanceof Element)) return;
          if (event.target.closest(".nav-control")) return;
          const header = document.querySelector(".site-header");
          const input = inputEl(header ?? undefined);
          if (!header || !input?.checked) return;
          if (!header.contains(event.target) || event.target.closest("#site-nav a")) {
            input.checked = false;
            sync(input);
          }
        });

        document.addEventListener("keydown", (event) => {
          const input = inputEl();
          if (!input) return;
          if ((event.key === "Enter" || event.key === " ") && event.target === input) {
            event.preventDefault();
            input.checked = !input.checked;
            sync(input);
            return;
          }
          if (event.key !== "Escape" || !input.checked) return;
          input.checked = false;
          sync(input);
          input.focus();
        });

        mobileNav.addEventListener("change", () => {
          const input = inputEl();
          if (!input?.checked) return;
          input.checked = false;
          sync(input);
        });

        document.addEventListener("astro:page-load", () => {
          const input = inputEl();
          if (input) sync(input);
        });
        sync(inputEl());
      }
    </script>
  </body>
</html>
