---
import "@fontsource/oswald/500.css";
import "@fontsource/oswald/600.css";
import "@fontsource/source-sans-3/400.css";
import "@fontsource/source-sans-3/600.css";
import "@fontsource/source-serif-4/400.css";
import "@fontsource/source-serif-4/600.css";
import { ClientRouter } from "astro:transitions";
import CadencePlayer from "../components/CadencePlayer.astro";
import NewsletterSignup from "../components/NewsletterSignup.astro";
import SponsorBar from "../components/SponsorBar.astro";
import "../styles/global.css";
import {
  DEFAULT_SOCIAL_ALT,
  DEFAULT_SOCIAL_HEIGHT,
  DEFAULT_SOCIAL_WIDTH,
  resolveSocialImage,
  usesDefaultSocialImage,
} from "../lib/social-image.mjs";
import { pageUrl } from "../lib/urls";
import { disclaimer, site } from "../site";

interface Props {
  title: string;
  description?: string;
  overlay?: boolean;
  /** Site-root or absolute self-hosted image. Wikimedia hotlinks are not used. */
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  /** Directory pages add the labeled sponsor bar in the footer. */
  sponsorBar?: boolean;
}
const {
  title,
  description = site.description,
  overlay = false,
  image,
  imageAlt,
  imageWidth,
  imageHeight,
  sponsorBar = false,
} = Astro.props;
const fullTitle = title === site.name ? title : `${title} · ${site.name}`;
const canonical = pageUrl(Astro.url.pathname);
const socialImage = resolveSocialImage(image, site.origin);
const defaultCard = usesDefaultSocialImage(image, site.origin);
const socialAlt = defaultCard ? DEFAULT_SOCIAL_ALT : imageAlt || title;
const socialWidth = defaultCard ? DEFAULT_SOCIAL_WIDTH : imageWidth;
const socialHeight = defaultCard ? DEFAULT_SOCIAL_HEIGHT : imageHeight;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={socialImage} />
    {socialWidth ? <meta property="og:image:width" content={socialWidth} /> : null}
    {socialHeight ? <meta property="og:image:height" content={socialHeight} /> : null}
    <meta property="og:image:alt" content={socialAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <ClientRouter />
    <Fragment set:html={'<!-- Cloudflare Web Analytics --><script type=\'module\' src=\'https://static.cloudflareinsights.com/beacon.min.js\' data-cf-beacon=\'{"token": "6674b1a24adb4708a64c73a6d81bf0e0"}\'></script><!-- End Cloudflare Web Analytics -->'} />
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <header class:list={["site-header", { overlay }]}>
      <div class="header-inner">
        <div>
          <a class="wordmark" href="/">{site.name}</a>
          <p class="tagline">{site.tagline}</p>
        </div>
        <nav class="nav" aria-label="Primary">
          <a href="/recipients">Recipients</a>
          <a href="/battles">Battles</a>
          <a href="/on-this-day">On this day</a>
          <a href="/audio">Cadences</a>
          <a href="/directory">Directory</a>
          <a href="/about">About</a>
        </nav>
      </div>
    </header>
    <main id="content">
      <slot />
    </main>
    <footer class="site-footer">
      {sponsorBar && <SponsorBar />}
      <NewsletterSignup />
      <div class="footer-inner">
        <p>{disclaimer}</p>
        <p>
          Official citations are U.S. government works. Photographs are shown only
          when a public-domain or Creative Commons file could be matched, with the
          license and credit on the page.
          <a href="/about">Sources and photo rules</a>.
          <a href="/valor-awards">U.S. military valor awards, ranked</a>.
          Optional cadence audio is a separate public-domain recording and stays off until you press play.
          <a href="/audio">Cadence credits</a>.
          <a href="/directory">Veteran-owned businesses and military museums</a>.
        </p>
      </div>
    </footer>
    <CadencePlayer />
  </body>
</html>
