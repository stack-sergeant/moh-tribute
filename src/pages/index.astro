---
import Base from "../layouts/Base.astro";
import { eraScenes, heroScene } from "../lib/imagery";
import { actLine, datasetStats, eraSlug, featuredOverrides, featuredPool, recipient, storyLabel } from "../lib/records";
import { site } from "../site";

const conflictCount = Object.keys(datasetStats.byConflict).length;
const capersSourceUrl =
  "https://www.dvidshub.net/news/568137/two-marine-corps-legends-awarded-medal-honor-inducted-into-hall-heroes";
const toCard = (person) => {
  const award = person.awards[0];
  return {
    id: person.id,
    name: person.name,
    rank: award.rank,
    branch: award.branch,
    conflict: award.conflict,
    line: actLine(award.citation),
    photo: person.photo?.url ?? "",
    label: storyLabel(person.name),
  };
};
const pool = featuredPool().map(toCard);
const pinned = Object.fromEntries(
  Object.entries(featuredOverrides)
    .map(([date, id]) => [date, recipient(id)])
    .filter(([, person]) => person)
    .map(([date, person]) => [date, toCard(person)]),
);
const buildDate = new Date().toLocaleDateString("en-CA", { timeZone: "America/New_York" });
const first = pinned[buildDate] ?? pool[0];
---
<Base title={site.name} overlay>
  <section class="hero">
    <img class="hero-photo" src={heroScene.url} alt={heroScene.alt} />
    <div class="hero-shade"></div>
    <div class="hero-copy">
      <h1>Above<br /><span>and beyond</span></h1>
      <blockquote cite={capersSourceUrl}>
        <p>“This medal does not belong to me. It belongs to the exceptional men who fought with me.”</p>
        <footer>James Capers Jr., Medal of Honor recipient</footer>
      </blockquote>
      <div class="hero-actions">
        <a class="btn" href="/recipients">Find a recipient</a>
        <a class="btn ghost" href="#featured">Today’s hero</a>
      </div>
    </div>
  </section>

  <section class="stat-row" aria-label="Archive totals">
    <div class="stat">
      <strong>{datasetStats.people.toLocaleString()}</strong>
      <span>Recipients</span>
    </div>
    <div class="stat">
      <strong>{conflictCount}</strong>
      <span>Conflicts in the record</span>
    </div>
    <div class="stat">
      <strong>{datasetStats.posthumousAwards.toLocaleString()}</strong>
      <span>Marked as posthumous</span>
    </div>
  </section>

  <section class="spotlight" id="featured" aria-labelledby="featured-heading">
    {first?.photo ? (
      <img id="featured-photo" src={first.photo} alt="" />
    ) : (
      <div class="nophoto"><p>No verified public-domain photo is on file yet.</p></div>
    )}
    <div class="spotlight-copy">
      <p class="kicker">Featured hero</p>
      <h2 id="featured-heading">{first?.name}</h2>
      <p class="rank-line" id="featured-rank">{[first?.rank, first?.branch, first?.conflict].filter(Boolean).join(" · ")}</p>
      <p id="featured-line">{first?.line}</p>
      <p><a class="btn" id="featured-link" href={first ? `/recipients/${first.id}` : "/recipients"}>{first?.label ?? "Read his story"}</a></p>
    </div>
  </section>

  <div class="wrap">
    <h2>From the Civil War to the war on terror</h2>
    <p class="lede">The same standard, every war. Open an era.</p>
  </div>
  <div class="era-grid">
    {eraScenes.map((item) => {
      const count = datasetStats.byEra[item.era as keyof typeof datasetStats.byEra] ?? 0;
      return (
        <a class="era-tile" href={`/eras/${eraSlug(item.era)}`}>
          <img src={item.scene.url} alt={item.scene.alt} />
          <div>
            <h3>{item.title}</h3>
            <p>{count.toLocaleString()} awards</p>
          </div>
        </a>
      );
    })}
  </div>
  <div class="wrap">
    <p class="credit-line">
      Era photographs are U.S. government works or Creative Commons files.
      Credits are on each image’s Wikimedia page, linked from the battle hubs that use them.
    </p>
    <p><a href="/battles">All battle and action pages</a></p>
  </div>
  <div class="page-credits" slot="credits">
    <p class="credit-line">
      {heroScene.credit}. {heroScene.license}.
      <a href={heroScene.sourceUrl}>Photograph source</a>.
    </p>
    <p class="credit-line">
      Quotation published by the <a href={capersSourceUrl}>U.S. Marine Corps on DVIDS, June 2026</a>.
    </p>
  </div>
</Base>

<script define:vars={{ pool, pinned }}>
  const photo = document.querySelector("#featured-photo");
  const heading = document.querySelector("#featured-heading");
  const rank = document.querySelector("#featured-rank");
  const line = document.querySelector("#featured-line");
  const link = document.querySelector("#featured-link");
  if (!pool.length || !heading || !link) {
    /* keep the server-rendered hero */
  } else {
    const now = new Date();
    const start = new Date(now.getFullYear(), 0, 0);
    const day = Math.floor((now.getTime() - start.getTime()) / 86400000);
    const today = [now.getFullYear(), String(now.getMonth() + 1).padStart(2, "0"), String(now.getDate()).padStart(2, "0")].join("-");
    const pick = pinned[today] ?? pool[(day + now.getFullYear()) % pool.length];
    if (photo instanceof HTMLImageElement && pick.photo) {
      photo.src = pick.photo;
      photo.alt = `Photograph associated with ${pick.name}`;
    }
    heading.textContent = pick.name;
    if (rank) rank.textContent = [pick.rank, pick.branch, pick.conflict].filter(Boolean).join(" · ");
    if (line) line.textContent = pick.line;
    if (link instanceof HTMLAnchorElement) {
      link.href = `/recipients/${pick.id}`;
      link.textContent = pick.label;
    }
  }
</script>
