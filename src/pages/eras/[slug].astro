---
import Base from "../../layouts/Base.astro";
import { sceneForEra } from "../../lib/imagery";
import { allRecipients, eras } from "../../lib/records";

export function getStaticPaths() {
  return eras().map(([era, count]) => ({
    params: {
      slug: era.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, ""),
    },
    props: { era, count },
  }));
}

interface Props { era: string; count: number }
const { era, count } = Astro.props;
const people = allRecipients.filter((person) => person.awards.some((award) => award.era === era));
---
<Base title={era} description={`Medal of Honor recipients recorded for ${era}.`}>
  {sceneForEra(era) && (
    <header class="battle-hero">
      <img src={sceneForEra(era)!.url} alt={sceneForEra(era)!.alt} />
      <div class="hero-shade"></div>
      <div class="hero-copy">
        <p class="kicker">Era</p>
        <h1>{era}</h1>
        <p class="hero-credit">{sceneForEra(era)!.credit}. {sceneForEra(era)!.license}.</p>
      </div>
    </header>
  )}
  <div class="wrap">
  <p class="lede">{count.toLocaleString()} awards in this era are in the archive. Open a name for the citation.</p>
  <p><a href="/recipients">Search the full directory</a></p>
  <ul class="roster">
    {people.map((person) => {
      const award = person.awards.find((item) => item.era === era) ?? person.awards[0];
      return (
        <li>
          <a href={`/recipients/${person.id}`}>{person.name}</a>
          <p class="meta">{[award.rank, award.conflict, award.actionYear, award.actionPlace].filter(Boolean).join(" · ")}</p>
        </li>
      );
    })}
  </ul>
  </div>
</Base>
