---
import Base from "../../layouts/Base.astro";
import { allRecipients, branches, conflicts, states } from "../../lib/records";
---
<Base title="Recipients" description="Search Medal of Honor recipients by name, conflict, branch, home state, and posthumous status.">
  <p class="kicker">Directory</p>
  <h1>Recipients</h1>
  <p class="lede">
    Filter by name, conflict, branch, home state, or whether the source entry
    marks the award as posthumous. A missing posthumous marker is not proof
    that the person survived.
  </p>
  <form id="filters" class="filters" role="search">
    <label>
      Name
      <input id="q" type="search" name="q" autocomplete="off" />
    </label>
    <label>
      Conflict
      <select id="conflict" name="conflict">
        <option value="">Any conflict</option>
        {conflicts().map((conflict) => <option value={conflict}>{conflict}</option>)}
      </select>
    </label>
    <label>
      Branch
      <select id="branch" name="branch">
        <option value="">Any branch</option>
        {branches().map((branch) => <option value={branch}>{branch}</option>)}
      </select>
    </label>
    <label>
      Home state
      <select id="state" name="state">
        <option value="">Any state</option>
        {states().map((state) => <option value={state}>{state}</option>)}
      </select>
    </label>
    <label>
      Posthumous marker
      <select id="posthumous" name="posthumous">
        <option value="">Any</option>
        <option value="yes">Marked posthumous</option>
        <option value="no">No posthumous marker</option>
      </select>
    </label>
  </form>
  <p id="count" class="result-count" aria-live="polite"></p>
  <ul id="roster" class="roster">
    {allRecipients.map((person) => {
      const award = person.awards[0];
      const conflictList = [...new Set(person.awards.map((item) => item.conflict))].join("|");
      const branchList = [...new Set(person.awards.map((item) => item.branch))].join("|");
      const posthumous = person.awards.some((item) => item.posthumous) ? "yes" : "no";
      return (
        <li
          data-name={`${person.name} ${person.nameSort}`.toLowerCase()}
          data-conflicts={conflictList}
          data-branches={branchList}
          data-state={person.homeState ?? ""}
          data-posthumous={posthumous}
        >
          <a href={`/recipients/${person.id}`}>{person.name}</a>
          {posthumous === "yes" && <span class="badge">Posthumous</span>}
          <p class="meta">
            {[award.rank, award.branch, award.conflict, award.actionYear, person.homeState].filter(Boolean).join(" · ")}
          </p>
        </li>
      );
    })}
  </ul>
  <div class="pager">
    <button type="button" id="prev">Previous</button>
    <span id="page-label"></span>
    <button type="button" id="next">Next</button>
  </div>
</Base>

<script>
  const pageSize = 40;
  const list = document.querySelector("#roster");
  const items = list ? [...list.querySelectorAll("li")] : [];
  const q = document.querySelector("#q");
  const conflict = document.querySelector("#conflict");
  const branch = document.querySelector("#branch");
  const state = document.querySelector("#state");
  const posthumous = document.querySelector("#posthumous");
  const count = document.querySelector("#count");
  const pageLabel = document.querySelector("#page-label");
  const prev = document.querySelector("#prev");
  const next = document.querySelector("#next");
  let page = 1;

  function readParams() {
    const params = new URLSearchParams(location.search);
    if (q instanceof HTMLInputElement) q.value = params.get("q") ?? "";
    if (conflict instanceof HTMLSelectElement) conflict.value = params.get("conflict") ?? "";
    if (branch instanceof HTMLSelectElement) branch.value = params.get("branch") ?? "";
    if (state instanceof HTMLSelectElement) state.value = params.get("state") ?? "";
    if (posthumous instanceof HTMLSelectElement) posthumous.value = params.get("posthumous") ?? "";
    page = Math.max(1, Number(params.get("page") ?? "1") || 1);
  }

  function writeParams() {
    const params = new URLSearchParams();
    if (q instanceof HTMLInputElement && q.value.trim()) params.set("q", q.value.trim());
    if (conflict instanceof HTMLSelectElement && conflict.value) params.set("conflict", conflict.value);
    if (branch instanceof HTMLSelectElement && branch.value) params.set("branch", branch.value);
    if (state instanceof HTMLSelectElement && state.value) params.set("state", state.value);
    if (posthumous instanceof HTMLSelectElement && posthumous.value) params.set("posthumous", posthumous.value);
    if (page > 1) params.set("page", String(page));
    const nextUrl = `${location.pathname}${params.toString() ? `?${params}` : ""}`;
    history.replaceState(null, "", nextUrl);
  }

  function matches(item) {
    const name = item.dataset.name ?? "";
    const query = q instanceof HTMLInputElement ? q.value.trim().toLowerCase() : "";
    if (query && !name.includes(query)) return false;
    const wantedConflict = conflict instanceof HTMLSelectElement ? conflict.value : "";
    if (wantedConflict && !(item.dataset.conflicts ?? "").split("|").includes(wantedConflict)) return false;
    const wantedBranch = branch instanceof HTMLSelectElement ? branch.value : "";
    if (wantedBranch && !(item.dataset.branches ?? "").split("|").includes(wantedBranch)) return false;
    const wantedState = state instanceof HTMLSelectElement ? state.value : "";
    if (wantedState && item.dataset.state !== wantedState) return false;
    const wantedPosthumous = posthumous instanceof HTMLSelectElement ? posthumous.value : "";
    if (wantedPosthumous && item.dataset.posthumous !== wantedPosthumous) return false;
    return true;
  }

  function render() {
    const matched = items.filter(matches);
    const pages = Math.max(1, Math.ceil(matched.length / pageSize));
    if (page > pages) page = pages;
    const start = (page - 1) * pageSize;
    const visible = new Set(matched.slice(start, start + pageSize));
    for (const item of items) item.hidden = !visible.has(item);
    if (count) {
      const end = Math.min(matched.length, start + pageSize);
      count.textContent = matched.length
        ? `Showing ${start + 1}–${end} of ${matched.length.toLocaleString()}`
        : "No recipients match these filters.";
    }
    if (pageLabel) pageLabel.textContent = `Page ${page} of ${pages}`;
    if (prev instanceof HTMLButtonElement) prev.disabled = page <= 1;
    if (next instanceof HTMLButtonElement) next.disabled = page >= pages;
    writeParams();
  }

  readParams();
  render();
  for (const control of [q, conflict, branch, state, posthumous]) {
    control?.addEventListener("input", () => { page = 1; render(); });
    control?.addEventListener("change", () => { page = 1; render(); });
  }
  prev?.addEventListener("click", () => { page -= 1; render(); });
  next?.addEventListener("click", () => { page += 1; render(); });
</script>
