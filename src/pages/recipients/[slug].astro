---
import Base from "../../layouts/Base.astro";
import { publicDomainPhotoUrl } from "../../lib/photos";
import { allRecipients, battle, gaveLifeLabel, neighbors, type Recipient } from "../../lib/records";

export function getStaticPaths() {
  return allRecipients.map((person) => ({ params: { slug: person.id }, props: { person } }));
}

interface Props { person: Recipient }
const { person } = Astro.props;
const lead = person.awards[0];
const photo = person.photo;
const { prev, next } = neighbors(person.id);
const posthumous = person.awards.some((award) => award.posthumous);
const mates = lead.battleId
  ? (battle(lead.battleId)?.recipientIds ?? [])
      .filter((id) => id !== person.id)
      .slice(0, 6)
      .map((id) => allRecipients.find((item) => item.id === id))
      .filter(Boolean)
  : [];
const cardImage = publicDomainPhotoUrl(photo);
---
<Base
  title={person.name}
  description={`Medal of Honor record for ${person.name}.`}
  image={cardImage}
  imageAlt={cardImage ? `Photograph associated with ${person.name}` : undefined}
  imageWidth={cardImage ? photo?.width : undefined}
  imageHeight={cardImage ? photo?.height : undefined}
>
  <header class="hero-person">
    {photo ? (
      <img src={photo.url} alt={`Photograph associated with ${person.name}`} width={photo.width ?? 800} height={photo.height ?? 1000} />
    ) : (
      <div class="nophoto"><p>No verified public-domain photo is on file yet.</p></div>
    )}
    <div class="hero-person-copy">
      <p class="kicker">{lead.conflict}</p>
      {posthumous && <p class="gave">{gaveLifeLabel(person.name)}</p>}
      <h1>{person.name}</h1>
      <p class="big-facts">{[lead.rank, lead.branch].filter(Boolean).join(" · ")}</p>
      {lead.unit && <p class="big-facts">{lead.unit}</p>}
      <p class="big-facts">{[lead.actionDateLabel ?? "Date not recorded", lead.actionPlace ?? "Place not recorded"].join(" · ")}</p>
      {photo && (
        <p class="credit-line">
          {photo.license}. {photo.credit}
          <a href={photo.pageUrl}>Source file</a>
        </p>
      )}
    </div>
  </header>
  <div class="wrap">
    <div class="pager-hero">
      {prev && <a class="btn ghost" href={`/recipients/${prev.id}`}>Previous hero · {prev.name}</a>}
      {next && <a class="btn ghost" href={`/recipients/${next.id}`}>Next hero · {next.name}</a>}
    </div>
    {person.awards.length > 1 && <p class="note">This person is recorded with {person.awards.length} Medals of Honor.</p>}
    {person.awards.map((award, index) => (
      <section class="award">
        {person.awards.length > 1 && <h2>Award {index + 1} · {award.conflict}</h2>}
        <dl class="facts">
          <dt>Branch</dt><dd>{award.branch}</dd>
          <dt>Era</dt><dd>{award.era}</dd>
          {person.homeState && <><dt>Home state</dt><dd>{person.homeState}</dd></>}
          {award.battleId && battle(award.battleId) && (
            <>
              <dt>Action</dt>
              <dd><a href={`/battles/${award.battleId}`}>{battle(award.battleId)?.title}</a></dd>
            </>
          )}
        </dl>
        <h2>The citation</h2>
        <blockquote class="inscription" cite={award.sourceUrl}>
          <p class="kicker">Official citation</p>
          <p>{award.citation}</p>
        </blockquote>
        <h3>Sources</h3>
        <ul class="source-list">
          <li><a href={award.sourceUrl}>{award.sourceLabel}</a></li>
          {award.extraSources.map((url) => <li><a href={url}>{url}</a></li>)}
          {person.wikipedia && <li><a href={person.wikipedia}>Wikipedia</a>. Linked only. The article text is not copied here.</li>}
        </ul>
      </section>
    ))}
    {mates.length > 0 && (
      <section>
        <h2>More from this battle</h2>
        <div class="card-row">
          {mates.map((mate) => mate && (
            <a class="person-card" href={`/recipients/${mate.id}`}>
              {mate.photo ? <img src={mate.photo.url} alt="" /> : <div class="nophoto"><p>No photo on file</p></div>}
              <div>
                <h3>{mate.name}</h3>
                <p class="meta">{mate.awards[0].rank}</p>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
</Base>
