---
import Base from "../layouts/Base.astro";
import { cadences } from "../lib/cadences";
---
<Base
  title="Cadence audio"
  description="Sources and public-domain status for the optional cadence recordings on Valor Record."
>
  <div class="wrap">
    <p class="kicker">Sound</p>
    <h1>Cadence audio</h1>
    <p class="lede">
      These tracks play only after you press Play cadences. Nothing starts by itself.
      The clips are quiet on purpose: the player opens at about one quarter volume.
    </p>
    <p>
      Each file is an excerpt of a recording produced by U.S. military public affairs and
      published on DVIDS. The recordings are U.S. government works and are marked public domain.
      Files are mono MP3 at 80 kbps.
    </p>
    <p class="note">
      The appearance of U.S. Department of War (DoW) visual information does not imply or
      constitute DoW endorsement.
    </p>

    <h2>Tracks</h2>
    {
      cadences.map((track) => (
        <article class="cadence-credit">
          <h3>
            {track.title}
            <span class="badge">{track.branch}</span>
          </h3>
          <p>{track.caller}</p>
          <p class="meta">
            {track.unit}. {track.place}. Recorded {track.recorded}. {track.credit}. VIRIN {track.virin}.
          </p>
          <p>{track.clip}</p>
          <p>{track.license}</p>
          <p>
            <a href={track.sourceUrl}>DVIDS source recording</a>
          </p>
        </article>
      ))
    }
  </div>
</Base>
